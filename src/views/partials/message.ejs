<% for (const message of messages) { %>
    <div>
        <h1><%= message.title %></h1>
        <div>
            <% if (isMember) { %>
                <span><%= message.first_name %> <%= message.last_name %></span>
                <span><%= message.username %></span>
            <% } else { %>
                <span>Member</span>
            <% } %>
        </div>
        <p>
            <%= message.message %>
        </p>
        <time datetime="<%= message.sent_at %>"><%= format(message.sent_at, "eee, MMM dd yyyy"); %></time>
        <div class="btn-control">
            <a href="/messages/delete/<%= message.message_id %>">Delete</a>
        </div>
    </div>
<% } %>